---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const img = (f: string) => `${base}/img/${f}`;
const version = '2.1.0';
const instalador = `https://github.com/alex123floresc-sketch/Space_Cat/releases/download/v${version}/SpaceCat-${version}.exe`;
const sha256 = 'F7461B795E7BA5DAA7421CC623B504358DE03255DCED201D0F5542107677CA03';
const whatsapp = 'https://wa.me/51919192008';

const funciones = [
  { id: 'casa', nombre: 'Casa completa', img: 'casa.png', w: 1426, h: 863,
    titulo: 'Toda la casa, como una maqueta',
    texto: 'Junta los ambientes en hasta cuatro pisos. La casa se ve con techo, fachada, patio, césped y árboles; con los botones P1 y P2 ocultas un piso, y con Techo miras adentro.',
    alt: 'Casa de ejemplo de dos pisos en 3D, con el área y el costo de cada ambiente' },
  { id: 'planta', nombre: 'Planta con medidas', img: 'planta.png', w: 1426, h: 863,
    titulo: 'Planta con medidas reales',
    texto: 'Mira cada ambiente desde arriba, con la medida de cada pared y de cada mueble. Cambia ancho, alto, color y acabado en el panel derecho.',
    alt: 'Planta 2D con cotas en metros y el panel de medidas de un mueble' },
  { id: 'recorrido', nombre: 'Recorrido', img: 'recorrido.png', w: 1426, h: 863,
    titulo: 'Camina por dentro',
    texto: 'Recorre el ambiente a la altura de los ojos con W, A, S y D. No atraviesas paredes ni muebles: así sabes si de verdad se puede pasar.',
    alt: 'Vista en primera persona dentro de la sala amoblada' },
  { id: 'presupuesto', nombre: 'Presupuesto', img: 'presupuesto.png', w: 900, h: 600,
    titulo: 'Cuánto cuesta, en soles',
    texto: 'Calcula los galones de pintura, el cerámico, el zócalo y los muebles. Cambia cualquier precio con doble clic y exporta la tabla.',
    alt: 'Ventana de metrado y presupuesto en soles' },
  { id: 'informe', nombre: 'Informe PDF', img: 'informe.png', w: 1881, h: 889,
    titulo: 'Un informe para entregar',
    texto: 'Medidas, planta, vista 3D, ubicación de cada mueble y presupuesto detallado, listo para imprimir o enviar por WhatsApp.',
    alt: 'Páginas del informe PDF con la planta, la vista 3D y el presupuesto' },
  { id: 'muebles', nombre: 'Tus muebles', img: 'muebles.png', w: 1180, h: 740,
    titulo: 'Arma el mueble que no está',
    texto: 'El catálogo trae 36 muebles con medidas editables. Si buscas otro, ármalo con piezas medidas en centímetros o importa un modelo 3D.',
    alt: 'Diseñador de muebles con un mueble armado por piezas' },
  { id: 'noche', nombre: 'Luz y noche', img: 'noche.png', w: 1426, h: 863,
    titulo: 'Luz de día y de noche',
    texto: 'Coloca lámparas y la luz del sol que entra por las ventanas. Apaga el sol con la tecla N para ver si la iluminación alcanza.',
    alt: 'Ambiente de noche iluminado solo por las lámparas' },
];

const instalar = [
  { n: 30, w: 1917, h: 1078, t: 'Descarga', d: 'Pulsa Descargar instalador. Cuando el navegador muestre «SpaceCat-2.1.0.exe · 61.4 MB · Listo», haz clic en esa línea.', alt: 'Descarga del instalador con el historial de descargas del navegador' },
  { n: 31, w: 680, h: 642, t: 'Aviso de Windows', d: 'Si aparece «Windows protegió su PC», comprueba que diga SpaceCat-2.1.0.exe y pulsa Ejecutar de todas formas (antes, Más información).', alt: 'Ventana Windows protegió su PC' },
  { n: 32, w: 621, h: 482, t: 'Bienvenida', d: 'El asistente está en inglés. En «Welcome to the Space Cat Setup Wizard», pulsa Next.', alt: 'Bienvenida del asistente de instalación' },
  { n: 33, w: 665, h: 546, t: 'Carpeta', d: 'Deja la carpeta que propone y pulsa Next. Si quieres otra, elígela con Change….', alt: 'Pantalla de carpeta de destino' },
  { n: 34, w: 638, h: 527, t: 'Instalar', d: 'En «Ready to install Space Cat», pulsa Install. No pide permisos de administrador.', alt: 'Pantalla lista para instalar' },
  { n: 35, w: 660, h: 531, t: 'Listo', d: 'En menos de un minuto termina. Pulsa Finish y abre Space Cat desde el menú Inicio o el escritorio.', alt: 'Pantalla de instalación en curso' },
];

const faqs = [
  { q: '¿Es gratis?', a: 'Sí. Space Cat se descarga e instala sin costo desde esta página.' },
  { q: '¿Necesito internet?', a: 'Solo para descargarla. Después funciona sin conexión: tus proyectos y el presupuesto se guardan en tu computadora.' },
  { q: '¿En qué computadoras funciona?', a: 'En Windows 10 y 11 de 64 bits. Con 4 GB de memoria ya funciona; 8 GB es lo recomendado.' },
  { q: '¿Por qué Windows dice «Windows protegió su PC»?', a: 'Porque el instalador todavía no tiene firma digital, no porque tenga un problema. Pulsa «Más información» y luego «Ejecutar de todas formas».' },
  { q: '¿Tenía Amoblador3D, pierdo mis proyectos?', a: 'No. Space Cat es la misma aplicación con otro nombre: la primera vez que la abres copia sola tus proyectos, diseños y precios.' },
  { q: '¿Dónde se guardan mis proyectos?', a: 'En tu computadora, en la carpeta de tu usuario. También puedes exportar cada proyecto como un archivo .amob3d para abrirlo en otra computadora.' },
  { q: '¿Los precios del presupuesto son reales?', a: 'Son precios referenciales en soles. Puedes cambiar cualquiera y se guardan para todos tus proyectos.' },
  { q: '¿Cómo la desinstalo?', a: 'En Configuración → Aplicaciones → Aplicaciones instaladas, busca Space Cat y elige Desinstalar. Tus proyectos no se borran.' },
];
---

<Base
  title="Space Cat: diseña tu casa en 3D con medidas reales"
  description="Space Cat es una aplicación gratuita para Windows: dibuja tu casa con medidas reales, amóblala en 3D, mírala por fuera y por dentro, y obtén el presupuesto en soles. Funciona sin internet."
>
  <header class="barra">
    <div class="contenedor">
      <a href="#" class="marca">
        <img src={img('cat_blanco.png')} alt="" width="24" height="34" />
        <span>Space Cat</span>
      </a>
      <button class="menu-movil" type="button" aria-expanded="false" aria-controls="nav-principal">Menú</button>
      <nav id="nav-principal" aria-label="Secciones">
        <a href="#casa-3d">Casa en 3D</a>
        <a href="#funciones">Funciones</a>
        <a href="#como">Cómo funciona</a>
        <a href="#instalar">Instalar</a>
        <a href="#ayuda">Ayuda</a>
        <a href="#descargar" class="btn btn-primario">Descargar</a>
      </nav>
    </div>
  </header>

  <main id="contenido">
    <!-- PORTADA -->
    <section class="contenedor portada">
      <div>
        <h1>Diseña tu casa antes de comprar un solo mueble.</h1>
        <p class="entrada">
          Dibuja cada ambiente con sus medidas reales, amóblalo en 3D, mira la casa por fuera y por
          dentro, y sabe cuánto cuesta en soles. Gratis para Windows y sin internet.
        </p>
        <div class="acciones">
          <a href="#descargar" class="btn btn-primario">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3v12m0 0l-4-4m4 4l4-4M5 21h14" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Descargar para Windows
          </a>
          <a href="#casa-3d" class="btn btn-linea">Ver la casa en 3D</a>
        </div>
        <p class="nota">Versión {version} · un solo instalador, con todo incluido.</p>
      </div>

      <figure class="lamina" style="margin:0">
        <div class="cota cota-h" aria-hidden="true"><span>9.00 m</span></div>
        <div class="cota cota-v" aria-hidden="true"><span>9.00 m</span></div>
        <div class="hoja">
          <img src={img('casa.png')} alt="Casa de ejemplo de dos pisos en Space Cat, con techo, fachada y jardín" width="1426" height="863" />
          <figcaption class="cartela">
            <span class="gato"><img src={img('cat_blanco.png')} alt="" width="27" height="38" /></span>
            <span><b>Casa de ejemplo</b>Dos pisos · 11 ambientes · 137.37 m²</span>
            <span><b>Space Cat</b>Versión {version}</span>
          </figcaption>
        </div>
      </figure>
    </section>

    <section class="contenedor">
      <ul class="datos">
        <li><strong data-contar="36">36</strong>muebles con medidas que puedes cambiar</li>
        <li><strong data-contar="4">4</strong>pisos por casa, con techo y fachada</li>
        <li><strong>S/</strong>metrado y presupuesto en soles</li>
        <li><strong>0</strong>conexiones a internet necesarias</li>
      </ul>
    </section>

    <!-- CASA EN 3D -->
    <section id="casa-3d" class="contenedor seccion">
      <h2>La casa de ejemplo, en 3D</h2>
      <p class="entrada">
        Es la misma casa que trae Space Cat: dos pisos sobre 9 × 9 m, con sus muebles a escala.
        <span class="solo-raton">Gírala arrastrando, acércala con la rueda y pasa el cursor por un ambiente para ver sus medidas.</span>
        <span class="solo-tactil">Gírala con un dedo y pellizca para acercarla.</span>
      </p>
      <div class="visor3d" data-visor3d>
        <div class="visor3d-escenario">
          <div class="visor3d-lienzo"></div>
          <div class="visor3d-tip" hidden></div>
          <div class="visor3d-cargando" aria-hidden="true"><span></span>Levantando muros…</div>
          <img class="visor3d-respaldo" src={img('casa.png')} alt="Casa de ejemplo de dos pisos en Space Cat" width="1426" height="863" loading="lazy" />
        </div>
        <div class="visor3d-panel">
          <div class="visor3d-controles" role="group" aria-label="Pisos visibles">
            <button type="button" data-vista="todo" aria-pressed="true">Todo</button>
            <button type="button" data-vista="0" aria-pressed="false">Piso 1</button>
            <button type="button" data-vista="1" aria-pressed="false">Piso 2</button>
          </div>
          <div class="visor3d-controles" role="group" aria-label="Opciones de la vista">
            <button type="button" data-techo aria-pressed="false">Techo</button>
            <button type="button" data-girar aria-pressed="true">Girar</button>
            <button type="button" data-repetir>Repetir</button>
          </div>
          <ul class="visor3d-lista" aria-label="Ambientes de la casa"></ul>
          <p class="visor3d-nota">Así se ve en la aplicación con la vista Casa. Ahí además puedes recorrerla por dentro.</p>
        </div>
      </div>
    </section>

    <!-- FUNCIONES -->
    <section id="funciones" class="contenedor seccion" style="padding-top:0">
      <h2>Lo que puedes hacer</h2>
      <p class="entrada">Todo a escala real: los muebles no se enciman ni tapan puertas, y cada cambio actualiza el presupuesto.</p>
      <div class="ui top attached tabular menu pestanas">
        {funciones.map((f, i) => (<a class={`item ${i === 0 ? 'active' : ''}`} data-tab={f.id}>{f.nombre}</a>))}
      </div>
      {funciones.map((f, i) => (
        <div class={`ui bottom attached tab segment panel ${i === 0 ? 'active' : ''}`} data-tab={f.id}>
          <div class="panel-grid">
            <button type="button" class="captura" data-ampliar={img(f.img)} aria-label={`Ampliar: ${f.alt}`}>
              <img src={img(f.img)} alt={f.alt} width={f.w} height={f.h} loading="lazy" />
              <span class="pista" aria-hidden="true">Ampliar</span>
            </button>
            <div>
              <h3>{f.titulo}</h3>
              <p>{f.texto}</p>
            </div>
          </div>
        </div>
      ))}
    </section>

    <!-- CÓMO FUNCIONA -->
    <section id="como" class="contenedor seccion" style="padding-top:0">
      <h2>Cómo funciona</h2>
      <p class="entrada">De la habitación vacía al presupuesto.</p>
      <ol class="pasos pasos-3">
        <li><h3>Dibuja</h3><p>Escribe el ancho, el largo y el alto de cada ambiente en metros, o empieza con una plantilla o con la casa de ejemplo.</p></li>
        <li><h3>Amuebla</h3><p>Arrastra muebles del catálogo. Se pegan a las paredes con su tamaño real y puedes girarlos, cambiarlos y recorrer el ambiente.</p></li>
        <li><h3>Calcula</h3><p>Mira cuánta pintura, cerámico y zócalo necesitas y cuánto cuesta en soles. Guárdalo como informe PDF.</p></li>
      </ol>
      <dl class="publico">
        <div><dt>Familias que construyen o remodelan</dt><dd>Prueban la distribución y saben cuánto material comprar antes de ir a la ferretería.</dd></div>
        <div><dt>Maestros de obra</dt><dd>Muestran al cliente cómo quedará el ambiente y entregan el presupuesto en PDF.</dd></div>
        <div><dt>Mueblerías</dt><dd>Comprueban con el cliente si el mueble entra, con sus medidas reales y en su color.</dd></div>
      </dl>
    </section>

    <!-- DESCARGAR -->
    <section id="descargar" class="contenedor seccion" style="padding-top:0">
      <h2>Descargar</h2>
      <p class="entrada">Un solo archivo: el instalador trae todo lo necesario, también Java. No hay que instalar nada más.</p>
      <div class="descarga">
        <div class="ficha-descarga">
          <div class="cabeza">
            <div>
              <h3>Space Cat {version} para Windows</h3>
              <p>SpaceCat-{version}.exe · 61.4 MB · Windows 10 u 11 de 64 bits</p>
            </div>
            <a href={instalador} class="btn btn-primario">Descargar instalador</a>
          </div>
          <p class="aviso">
            Al abrirlo, Windows puede mostrar <em>«Windows protegió su PC»</em> porque el programa aún no
            tiene firma digital. Pulsa <em>Más información</em> y luego <em>Ejecutar de todas formas</em>.
          </p>
          <details class="huella">
            <summary>Comprobar que el archivo es original (SHA-256)</summary>
            <p style="margin:.6rem 0 0">En PowerShell, dentro de Descargas, escribe <code style="display:inline">Get-FileHash .\SpaceCat-{version}.exe</code>. El resultado debe ser:</p>
            <code>{sha256}</code>
          </details>
        </div>

        <div>
          <h3>Manuales</h3>
          <ul class="manuales" style="margin-top:1rem">
            <li><a href={`${base}/descargas/Space_Cat_Manual_de_Instalacion.pdf`}><b>Manual de instalación</b><small>PDF · 19 páginas · cada pantalla del instalador, explicada</small><span class="abrir">Abrir</span></a></li>
            <li><a href={`${base}/descargas/Space_Cat_Manual_de_Usuario.pdf`}><b>Manual de usuario</b><small>PDF · 48 páginas · cada función paso a paso</small><span class="abrir">Abrir</span></a></li>
          </ul>
          <h3 class="subtitulo">Requisitos</h3>
          <table class="requisitos">
            <thead><tr><th></th><th>Mínimo</th><th>Recomendado</th></tr></thead>
            <tbody>
              <tr><th>Sistema</th><td>Windows 10, 64 bits</td><td>Windows 11</td></tr>
              <tr><th>Memoria</th><td>4 GB</td><td>8 GB</td></tr>
              <tr><th>Video</th><td>Gráficos con 3D</td><td>Tarjeta dedicada</td></tr>
              <tr><th>Disco</th><td>300 MB</td><td>1 GB</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- INSTALAR -->
    <section id="instalar" class="contenedor seccion" style="padding-top:0">
      <h2>Instalar, paso a paso</h2>
      <p class="entrada">Las pantallas reales del instalador. Cada flecha roja señala lo que hay que pulsar.</p>
      <ol class="pasos pasos-instalar">
        {instalar.map((p) => (
          <li>
            <button type="button" class="captura" data-ampliar={img(`paso_${p.n}.png`)} aria-label={`Ampliar: ${p.alt}`}>
              <img src={img(`paso_${p.n}.png`)} alt={p.alt} width={p.w} height={p.h} loading="lazy" />
              <span class="pista" aria-hidden="true">Ampliar</span>
            </button>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- AYUDA -->
    <section id="ayuda" class="contenedor seccion" style="padding-top:0">
      <h2>Preguntas frecuentes</h2>
      <div class="ui accordion preguntas">
        {faqs.map((f) => (
          <>
            <div class="title"><i class="dropdown icon"></i>{f.q}</div>
            <div class="content"><p>{f.a}</p></div>
          </>
        ))}
      </div>
    </section>

    <section class="contenedor" style="padding-bottom:clamp(4rem,8vw,6rem)">
      <div class="contacto">
        <div>
          <h2 style="font-size:var(--t-2)">¿Tienes una consulta?</h2>
          <p>Escríbenos por WhatsApp y te ayudamos a instalarla o a usarla.</p>
        </div>
        <a href={whatsapp} target="_blank" rel="noopener" class="btn btn-primario">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.33 4.95L2 22l5.3-1.38a9.86 9.86 0 004.74 1.2h.01c5.46 0 9.9-4.44 9.9-9.9 0-2.64-1.03-5.13-2.9-7A9.82 9.82 0 0012.04 2zm5.8 14.12c-.25.69-1.44 1.32-1.98 1.36-.53.05-1.02.24-3.45-.72-2.9-1.14-4.73-4.1-4.87-4.29-.14-.19-1.16-1.54-1.16-2.94s.73-2.08 1-2.37c.26-.29.57-.36.76-.36.19 0 .38 0 .55.01.18.01.42-.07.65.5.25.6.84 2.08.91 2.23.07.14.12.31.02.5-.09.19-.14.31-.28.48-.14.17-.3.37-.42.5-.14.14-.29.29-.12.57.17.29.73 1.2 1.56 1.94 1.07.96 1.98 1.25 2.26 1.4.28.14.44.12.6-.07.17-.19.69-.8.87-1.08.18-.29.37-.24.62-.14.25.09 1.6.75 1.87.89.28.14.46.21.53.33.07.12.07.69-.18 1.38z"/></svg>
          Escribir por WhatsApp
        </a>
      </div>
    </section>
  </main>

  <footer class="pie">
    <div class="contenedor">
      <a href="#" class="marca"><img src={img('cat_blanco.png')} alt="" width="20" height="28" style="height:28px" /><span style="font-size:1rem">Space Cat</span></a>
      <nav aria-label="Pie">
        <a href="#funciones">Funciones</a>
        <a href="#descargar">Descargar</a>
        <a href="#instalar">Instalar</a>
        <a href="#ayuda">Ayuda</a>
      </nav>
      <span>© 2026 Space Cat · Hecho en Juliaca, Perú</span>
    </div>
  </footer>

  <dialog id="visor" class="visor" aria-label="Captura ampliada">
    <form method="dialog"><button type="submit">Cerrar (Esc)</button></form>
    <img alt="" />
  </dialog>
</Base>

<script>
  // La vista 3D se carga solo cuando el visitante llega cerca de la sección.
  const raiz = document.querySelector('[data-visor3d]');
  if (raiz) {
    const io = new IntersectionObserver(async ([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      try {
        const { montar } = await import('../scripts/casa3d.js');
        montar(raiz);
      } catch (err) {
        console.error(err);
        raiz.classList.add('sin-webgl');
      }
    }, { rootMargin: '400px' });
    io.observe(raiz);
  }
</script>
