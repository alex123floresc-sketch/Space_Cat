---
import '../styles/global.css';
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = 'https://alex123floresc-sketch.github.io/Space_Cat/';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111111" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={site} />
    <meta property="og:image" content={`${site}img/casa.png`} />
    <meta property="og:locale" content="es_PE" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={site} />
    <link rel="icon" href={`${base}/favicon.png`} type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,400;0,500;0,600;0,700;1,400&family=IBM+Plex+Mono:wght@400;600;700&family=Unbounded:wght@700;800;900&display=swap"
      rel="stylesheet"
    />
    <!-- Fomantic UI: solo los componentes de acordeón y pestañas -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fomantic-ui@2.9.3/dist/semantic.min.css" />
  </head>
  <body>
    <a class="saltar" href="#contenido">Ir al contenido</a>
    <slot />

    <!-- jQuery + Fomantic JS al final, para el acordeón y las pestañas -->
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js" is:inline></script>
    <script src="https://cdn.jsdelivr.net/npm/fomantic-ui@2.9.3/dist/semantic.min.js" is:inline></script>
    <script is:inline>
      window.addEventListener('load', () => {
        if (window.jQuery) {
          jQuery('.ui.accordion').accordion({ exclusive: false });
          jQuery('.ui.menu .item').tab();
        }
      });
      // Ampliar capturas
      document.addEventListener('click', (e) => {
        const b = e.target.closest('[data-ampliar]');
        const visor = document.getElementById('visor');
        if (!b || !visor || typeof visor.showModal !== 'function') return;
        visor.querySelector('img').src = b.dataset.ampliar;
        visor.querySelector('img').alt = b.querySelector('img')?.alt || '';
        visor.showModal();
      });
      document.getElementById('visor')?.addEventListener('click', (e) => {
        if (e.target.id === 'visor') e.target.close();
      });
      // Barra con sombra al bajar
      const barra = document.querySelector('.barra');
      const sombra = () => barra?.classList.toggle('bajando', scrollY > 8);
      addEventListener('scroll', sombra, { passive: true });
      sombra();
      // Títulos y pasos se marcan al entrar en pantalla (la animación está en el CSS)
      document.querySelectorAll('.pasos').forEach((ol) =>
        ol.querySelectorAll(':scope > li').forEach((li, i) => li.style.setProperty('--i', i)));
      const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const contar = (el) => {
        if (quieto) return;
        el.querySelectorAll('[data-contar]').forEach((n) => {
          const fin = Number(n.dataset.contar), t0 = performance.now();
          const paso = (t) => {
            const x = Math.min(1, (t - t0) / 1100);
            n.textContent = Math.round(fin * (1 - Math.pow(1 - x, 3)));
            if (x < 1) requestAnimationFrame(paso);
          };
          requestAnimationFrame(paso);
        });
      };
      const marcar = (el) => { el.classList.add('visto'); if (el.matches('.datos')) contar(el); };
      const io = 'IntersectionObserver' in window
        ? new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { marcar(e.target); io.unobserve(e.target); } }), { rootMargin: '0px 0px -12% 0px' })
        : null;
      document.querySelectorAll('.seccion, .pasos, .datos').forEach((el) => (io ? io.observe(el) : marcar(el)));
      // Menú en móvil
      const boton = document.querySelector('.menu-movil');
      const nav = document.getElementById('nav-principal');
      boton?.addEventListener('click', () => {
        const abierto = boton.getAttribute('aria-expanded') !== 'true';
        boton.setAttribute('aria-expanded', abierto);
        nav.classList.toggle('abierto', abierto);
      });
      nav?.addEventListener('click', (e) => {
        if (e.target.closest('a')) { boton.setAttribute('aria-expanded', 'false'); nav.classList.remove('abierto'); }
      });
    </script>
  </body>
</html>
